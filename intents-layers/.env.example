# 1Claw API (same as other agent examples)
ONECLAW_BASE_URL=https://api.1claw.co

# Agent with intents_api_enabled, read policy on signing key
ONECLAW_AGENT_ID=
ONECLAW_AGENT_API_KEY=

# ── Solver layer (Layer A) ─────────────────────────────────────────────
# mock  = toy no-op on Sepolia (default)
# 1inch = live quote from 1inch Swap API (needs API key + token params)
SOLVER_MODE=mock

# Used when SOLVER_MODE=mock only
# DEMO_TO_ADDRESS=0x0000000000000000000000000000000000000000

# ── 1inch (when SOLVER_MODE=1inch) ─────────────────────────────────────
# https://portal.1inch.dev/ — Bearer token (must be non-empty; a blank ONEINCH_API_KEY= line fails)
ONEINCH_API_KEY=
# Optional: path to a file whose first line is the token (keeps secrets out of .env)
# ONEINCH_API_KEY_FILE=/path/to/1inch-token.txt

# Chain id: 1 = Ethereum mainnet (reliable). 11155111 = Sepolia (may be unsupported → use mock or mainnet).
CHAIN_ID=1

# Must match the address derived from keys/{chain}-signer in the vault (same checksummed EOA 1inch expects as `from`)
QUOTE_FROM_ADDRESS=

# Sell / buy ERC-20s (use 0xEeeeeEeeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE for native ETH on 1inch)
SWAP_SRC_TOKEN=0xEeeeeEeeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE
SWAP_DST_TOKEN=
# Sell amount in smallest units (e.g. wei for ETH: 1000000000000000 = 0.001 ETH)
SWAP_AMOUNT=
SWAP_SLIPPAGE_PERCENT=2

# ── Layer B behaviour ──────────────────────────────────────────────────
# Omit or not "1" = sign-only (no gas spend beyond any RPC simulation)
# BROADCAST=1 = submitTransaction (real on-chain tx + gas). Use tiny amounts on testnet first.
# BROADCAST=1
# SIMULATE_FIRST=false
