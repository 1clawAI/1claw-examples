# 1Claw API base URL
ONECLAW_BASE_URL=https://api.1claw.co

# Your 1Claw API key (user key 1ck_ or agent key ocv_)
ONECLAW_API_KEY=1ck_your_key_here

# Optional: Agent UUID (for agent API keys)
# ONECLAW_AGENT_ID=your-agent-uuid

# Optional: Existing vault ID (skips vault creation)
# ONECLAW_VAULT_ID=your-vault-uuid
