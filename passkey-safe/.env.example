# A human user key (1ck_...) — https://1claw.co/settings/api-keys.
# Passkey Safes are owned by a HUMAN's passkey; every create/list/prepare/
# execute/grant call requires a user session, not an agent (ocv_) key.
ONECLAW_API_KEY=1ck_...

# Optional: an existing agent this org owns, to demo the agent-spend side
# (granting that agent an allowance against your Safe). Needs its own
# Ethereum signing key first — POST /v1/agents/{id}/signing-keys.
ONECLAW_AGENT_ID=

ONECLAW_BASE_URL=https://api.1claw.co
