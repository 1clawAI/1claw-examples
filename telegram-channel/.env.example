ONECLAW_API_KEY=1ck_your_api_key_here
ONECLAW_BASE_URL=https://api.1claw.co

# The agent that owns this channel — see examples/basic for how to create one.
ONECLAW_AGENT_ID=00000000-0000-0000-0000-000000000000

# A bot token from @BotFather (Telegram → search "BotFather" → /newbot).
# Free, self-service, no app review — this is why the example uses Telegram
# rather than Discord (needs an Ed25519-signed interaction endpoint) or
# WhatsApp (Business API onboarding).
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-here

# For send-message.ts / list-messages.ts, once a channel exists.
ONECLAW_CHANNEL_ID=00000000-0000-0000-0000-000000000000
# Your own numeric Telegram user/chat id (send /start to your bot, then check
# the channel's message history — list-messages.ts prints external_chat_id).
TELEGRAM_CHAT_ID=123456789
