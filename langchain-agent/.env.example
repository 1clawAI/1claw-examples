# LLM: set one (OpenAI or Gemini free tier)
OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...   # Get free key at https://aistudio.google.com/apikey

# 1Claw Agent API key (ocv_ prefixed, auto-refreshes JWT and discovers vault)
