# 1Claw agent credentials (optional; in-memory keys used if unset)
# Option 1 — Master key only: set ONECLAW_API_KEY below. On first API request the app
#   creates Alice & Bob in your org and loads their keys (same as bootstrap).
# Option 2 — Stable .env: run `npm run bootstrap` to write Alice/Bob IDs and keys here.
ONECLAW_ALICE_AGENT_ID=
ONECLAW_ALICE_API_KEY=
ONECLAW_BOB_AGENT_ID=
ONECLAW_BOB_API_KEY=

# 1Claw API base URL
ONECLAW_BASE_URL=https://api.1claw.co

# Your personal 1Claw API key (1ck_...). Used by `npm run bootstrap` and by the UI
# when Alice/Bob env vars are not set — agents are created automatically on first load.
ONECLAW_API_KEY=

# Shroud LLM settings for AI auto-chat (each agent uses its own id:api_key to Shroud)
# Bootstrap enables shroud_enabled on Alice/Bob for JWT + org LLM token billing.
# Provider: google, openai, anthropic, mistral, cohere, openrouter
LLM_PROVIDER=google
# Optional: override model (default per provider, e.g. gemini-2.5-flash for google)
# LLM_MODEL=gemini-2.5-flash
# Optional: max completion tokens (default 512; too low truncates replies mid-sentence)
# LLM_MAX_TOKENS=512
# Optional: your Google/OpenAI/etc. key for BYOK. Leave empty to use org LLM billing via Shroud.
LLM_API_KEY=
# Shroud URL (default: https://shroud.1claw.co)
SHROUD_URL=https://shroud.1claw.co
