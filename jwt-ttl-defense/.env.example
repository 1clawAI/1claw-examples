# 1Claw API base URL
ONECLAW_BASE_URL=https://api.1claw.xyz

# Your 1Claw USER API key (1ck_...). This key is used to provision the demo:
#   - create a vault and store a secret
#   - register a short-lived agent (token_ttl_seconds = 3)
#   - grant a narrow read policy on `api/**`
#
# Get one at https://1claw.xyz/settings/api-keys (needs permission to create
# agents and policies, so a 1ck_ user key is required — ocv_ agent keys
# cannot create other agents).
ONECLAW_API_KEY=1ck_your_user_key_here

# Optional: a real OpenWeather API key to store as the "real" secret.
# If unset, a realistic placeholder is stored and the weather call is skipped.
# Get a free key at https://openweathermap.org/api
# DEMO_OPENWEATHER_KEY=

# Optional: a real city for the weather call (default: Malibu,US).
# DEMO_WEATHER_CITY=Malibu,US

# Optional: how long the attacker waits before trying to exfiltrate (seconds).
# Default: 4 (longer than the 3s JWT TTL, so the "slow attacker" scenario
# demonstrates token expiry).
# ATTACKER_SLOW_DELAY_SECONDS=4

# Optional: enable Shroud LLM proxy for the demo agent.
#   - Agent is registered with `shroud_enabled: true` + a strict
#     `shroud_config` (response_filter, tool_call_inspection, and
#     network_detection with evil.example blocked).
#   - When a GEMINI_API_KEY or OPENAI_API_KEY is set, the victim sends a
#     real LLM request through shroud.1claw.xyz. Shroud inspects the
#     response inside the TEE before the agent sees it.
#   - Without an LLM key, the demo falls back to local regex emulation.
#   - When Shroud catches the exfil, the JWT never reaches the
#     attacker and Act 2 is skipped.
# Set to 1 / true / yes / on to enable. Default: off.
# DEMO_SHROUD=1

# Shroud TEE proxy URL (real LLM traffic routes through here).
# ONECLAW_SHROUD_URL=https://shroud.1claw.xyz

# Optional: Google Gemini API key for real Shroud LLM traffic (DEMO_SHROUD=1).
# Get a free key at https://aistudio.google.com/apikey
# When set + DEMO_SHROUD=1, the victim agent sends a real LLM request
# through shroud.1claw.xyz → Gemini. Shroud's TEE filters inspect the
# response and block credential exfiltration.
# GEMINI_API_KEY=

# Optional: OpenAI API key (alternative to Gemini).
# OPENAI_API_KEY=
