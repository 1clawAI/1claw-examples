# 1Claw Platform Connect Example
# Copy to .env and fill in your values

# Platform API key (plt_ prefixed) — obtain from dashboard or POST /v1/platform/apps
ONECLAW_PLATFORM_KEY=plt_your_platform_key_here

# Optional: override API URL (defaults to https://api.1claw.co)
# ONECLAW_BASE_URL=https://api.1claw.co
