# A human API key (Settings → API Keys) — mints the router key. Never ship this to an agent.
ONECLAW_API_KEY=1ck_...
# A Shroud-enabled agent in your org
ONECLAW_AGENT_ID=
# Optional: your own OpenAI key (BYOK). Without it the agent's vault-stored key is used.
OPENAI_API_KEY=
ONECLAW_API_URL=https://api.1claw.co
