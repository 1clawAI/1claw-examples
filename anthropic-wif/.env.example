# Required: 1claw user API key (1ck_...) used to provision the demo agent.
ONECLAW_API_KEY=1ck_replace_me

# Required: the audience Anthropic configured on its WIF provider.
# Default works for Anthropic's standard WIF setup.
WIF_AUDIENCE=https://api.anthropic.com

# Optional: override the 1claw API base URL (production by default).
ONECLAW_BASE_URL=https://api.1claw.co

# Optional: set to 1 to skip the actual Anthropic exchange — useful for CI
# when you don't have a live Anthropic WIF provider configured. The script
# will mint and decode the federated JWT, then exit.
DEMO_SKIP_ANTHROPIC=0

# Optional: Anthropic's WIF token endpoint (override only if Anthropic moves it).
ANTHROPIC_WIF_TOKEN_URL=https://api.anthropic.com/v1/oauth/token
