# 1Claw API base URL
ONECLAW_BASE_URL=https://api.1claw.xyz

# Your 1Claw API key (user key from https://1claw.xyz/settings/api-keys)
# User API keys start with 1ck_, agent keys start with ocv_
ONECLAW_API_KEY=1ck_your_key_here

# Optional: Agent UUID. When set, npm start uses agent token (for agent API keys).
# ONECLAW_AGENT_ID=your-agent-uuid

# Free tier: 1,000 requests/month. Upgrade at https://1claw.xyz/pricing
