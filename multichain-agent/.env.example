# Copy to .env.local (Next.js convention)
ONECLAW_BASE_URL=https://api.1claw.xyz

# Human API key (1ck_) — used by `npm run bootstrap` to create agent + signing keys
ONECLAW_API_KEY=

# Filled by bootstrap:
ONECLAW_AGENT_ID=
ONECLAW_AGENT_API_KEY=

# Optional: Cardano Preprod balance checks in Funding panel
BLOCKFROST_PREPROD_KEY=

# Chat (Gemini) — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
