# Human API key (1ck_) — required for policy grant, human lease, and optional agent bootstrap
ONECLAW_API_KEY=1ck_your_key_here
ONECLAW_BASE_URL=https://api.1claw.xyz

# Optional: reuse an existing agent instead of creating one for the demo
# ONECLAW_AGENT_ID=
# ONECLAW_AGENT_API_KEY=ocv_...

# Optional: probe Shroud with X-Shroud-Provider: bankr after a successful lease
# ONECLAW_SHROUD_URL=https://shroud.1claw.xyz
# BANKR_SHROUD_PROBE=1
