# ─── 1Claw auth (required) ───
# Human key (Pro+) — create bindings. Or use email/password below.
# ONECLAW_API_KEY=1ck_your_human_api_key_here
ONECLAW_EMAIL=your_email@example.com
ONECLAW_PASSWORD=your_password

# API base (default https://api.1claw.xyz). Production blocks localhost/private hosts.
# ONECLAW_BASE_URL=https://api.1claw.xyz

# Agent under test (leave empty to create a disposable test agent)
# ONECLAW_AGENT_ID=
# ONECLAW_AGENT_API_KEY=ocv_…

# ─── HTTP / GraphQL (free public APIs) ───
# GitHub: https://github.com/settings/tokens (read:user)
# GITHUB_TOKEN=ghp_…
# OpenWeatherMap: https://openweathermap.org/api
# OPENWEATHER_API_KEY=

# ─── PostgreSQL — Neon / Supabase (public hostname required) ───
# https://neon.tech or https://supabase.com → connection settings
# EXEC_POSTGRES_HOST=ep-xxxx.us-east-2.aws.neon.tech
# EXEC_POSTGRES_PORT=5432
# EXEC_POSTGRES_USER=neondb_owner
# EXEC_POSTGRES_PASSWORD=
# EXEC_POSTGRES_DATABASE=neondb
# EXEC_POSTGRES_SSLMODE=require

# ─── MySQL — PlanetScale / TiDB Cloud / Aiven ───
# EXEC_MYSQL_HOST=aws.connect.psdb.cloud
# EXEC_MYSQL_PORT=3306
# EXEC_MYSQL_USER=
# EXEC_MYSQL_PASSWORD=
# EXEC_MYSQL_DATABASE=

# ─── Redis — Upstash (use TLS) ───
# https://console.upstash.com → REST/Redis URL
# EXEC_REDIS_URL=rediss://default:TOKEN@xxxx.upstash.io:6379
# Or structured:
# EXEC_REDIS_HOST=xxxx.upstash.io
# EXEC_REDIS_PORT=6379
# EXEC_REDIS_PASSWORD=
# EXEC_REDIS_TLS=true

# ─── SMTP — plain TCP only (no STARTTLS in executor) ───
# Prefer Mailtrap sandbox on a non-TLS port, or use HTTP binding for SendGrid/Resend.
# EXEC_SMTP_HOST=sandbox.smtp.mailtrap.io
# EXEC_SMTP_PORT=2525
# EXEC_SMTP_USER=
# EXEC_SMTP_PASSWORD=
# EXEC_SMTP_FROM=1claw-test@yourdomain.com

# ─── S3-compatible — Cloudflare R2 / AWS / B2 ───
# R2: https://developers.cloudflare.com/r2/
# EXEC_S3_ACCESS_KEY_ID=
# EXEC_S3_SECRET_ACCESS_KEY=
# EXEC_S3_REGION=auto
# EXEC_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# EXEC_S3_BUCKET=1claw-exec-test

# ─── Cloud SDK — least-privilege test keys only ───
# AWS IAM user (e.g. sts:GetCallerIdentity only)
# EXEC_AWS_ACCESS_KEY_ID=AKIA…
# EXEC_AWS_SECRET_ACCESS_KEY=
# EXEC_AWS_REGION=us-east-1

# GCP service account JSON file (paste into binding via bootstrap script)
# EXEC_GCP_SA_JSON_FILE=/path/to/sa.json

# Azure app registration
# EXEC_AZURE_TENANT_ID=
# EXEC_AZURE_CLIENT_ID=
# EXEC_AZURE_CLIENT_SECRET=

# ─── gRPC-JSON — Connect demo ───
# EXEC_GRPC_BASE_URL=https://demo.connectrpc.com

# ─── Custom HTTP ───
# EXEC_CUSTOM_BASE_URL=https://api.example.com
# EXEC_CUSTOM_API_KEY=
