# Copy to .env (gitignored) and fill in test credentials.
# Loaded automatically by scripts/lib/execution-intents-real-services.sh
# when ONECLAW_ENV_FILE is unset.

# Opt-in: set to 1 to run real-service smokes even if only some creds are present.
# EXEC_INTENTS_REAL_SERVICES=1

# --- HTTP / GraphQL (free tiers) ---
# GITHUB_TOKEN=ghp_...

# The Graph (Subgraph Studio API key) — https://thegraph.com/studio/apikeys/
EXEC_THEGRAPH_API_KEY=
# Default smoke subgraph: Uniswap V3 Ethereum (override if needed)
EXEC_THEGRAPH_SUBGRAPH_ID=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV

# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T…/B…/…

# OpenAI (ai_generate / Shroud BYOK) — OPENAPI_API_KEY is accepted as a typo alias
# OPENAI_API_KEY=sk-...

# EXEC_TWITTERAPI_KEY=

# --- Databases ---
# Neon: paste the **connection string** from Dashboard → Connect (NOT the napi_ API key).
# Wrap in single quotes if the password contains special characters (& ? # etc.):
# EXEC_POSTGRES_NEON='postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require'
# Or discrete fields:
# EXEC_POSTGRES_HOST=
# EXEC_POSTGRES_PORT=5432
# EXEC_POSTGRES_USER=postgres
# EXEC_POSTGRES_PASSWORD=
# EXEC_POSTGRES_DATABASE=postgres
# EXEC_POSTGRES_SSLMODE=require

# EXEC_MYSQL_HOST=
# EXEC_MYSQL_PORT=3306
# EXEC_MYSQL_USER=
# EXEC_MYSQL_PASSWORD=
# EXEC_MYSQL_DATABASE=

# EXEC_REDIS_URL=rediss://default:password@host:6379
# or EXEC_REDIS_HOST= / EXEC_REDIS_PORT=6379 / EXEC_REDIS_PASSWORD=

# --- Object storage / cloud SDK ---
# Minimal AWS setup (admin profile): examples/execution-intents/setup-aws-exec-test.sh --write-env
# Policy scope: sts:GetCallerIdentity + s3:ListBucket on a dedicated test bucket only.
# EXEC_S3_ACCESS_KEY_ID=
# EXEC_S3_SECRET_ACCESS_KEY=
# EXEC_S3_BUCKET=1claw-exec-test-<suffix>
# EXEC_S3_REGION=us-east-1
# EXEC_S3_ENDPOINT=

# Same keys work for cloud_sdk STS smoke when policy includes sts:GetCallerIdentity:
# EXEC_AWS_ACCESS_KEY_ID=
# EXEC_AWS_SECRET_ACCESS_KEY=
# EXEC_AWS_REGION=us-east-1

# --- gRPC demo (public Connect RPC — no credentials) ---
# Binding real-grpc: service connectrpc.demo.v1, method Say
# EXEC_GRPC_BASE_URL=https://demo.connectrpc.com
