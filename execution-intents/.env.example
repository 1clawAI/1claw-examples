# ─── Authentication (choose one method) ───

# Option A: API key (1ck_ human key on Pro+ tier)
# ONECLAW_API_KEY=1ck_your_human_api_key_here

# Option B: Email/password login
ONECLAW_EMAIL=your_email@example.com
ONECLAW_PASSWORD=your_password

# Base URL (default https://api.1claw.xyz)
# ONECLAW_BASE_URL=https://api.1claw.xyz

# ─── Optional: enrich the demo with real API calls ───

# GitHub personal access token (shows credential injection)
# GITHUB_TOKEN=ghp_your_token_here

# OpenWeatherMap API key (free tier: https://openweathermap.org/api)
# OPENWEATHER_API_KEY=your_openweather_key_here
